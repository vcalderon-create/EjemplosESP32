#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128 // Ancho de pantalla OLED en píxeles
#define SCREEN_HEIGHT 64 // Alto de pantalla OLED en píxeles

// Pines para los nuevos componentes
#define PIN_LED 18
#define PIN_BOTON 19

// Crear objeto pantalla OLED conectado por I2C
Adafruit_SSD1306 oled(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

int contador = 0;
bool estadoAnteriorBoton = HIGH;

void setup() {
  Serial.begin(9600);

  // Configurar pines del LED y del botón
  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_BOTON, INPUT_PULLUP); // Resistencia interna activada

  // Inicializar pantalla OLED con dirección I2C 0x3C
  if (!oled.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("Fallo al iniciar la pantalla SSD1306"));
    while (1);
  }

  delay(1000);
  actualizarPantalla("Sistema listo", contador);
}

void loop() {
  bool estadoActualBoton = digitalRead(PIN_BOTON);

  // Detectar si se acaba de pulsar el botón (flanco de bajada)
  if (estadoAnteriorBoton == HIGH && estadoActualBoton == LOW) {
    contador++;
    digitalWrite(PIN_LED, HIGH); // Encender LED
    actualizarPantalla("Boton PULSADO", contador);
    delay(200); // Pequeña pausa para evitar rebotes
  } 
  else if (estadoActualBoton == HIGH) {
    digitalWrite(PIN_LED, LOW); // Apagar LED al soltar
  }

  estadoAnteriorBoton = estadoActualBoton;
}

// Función para limpiar y escribir los nuevos datos en la OLED
void actualizarPantalla(String mensaje, int cuenta) {
  oled.clearDisplay();
  
  oled.setTextSize(1);
  oled.setTextColor(WHITE);
  oled.setCursor(0, 5);
  oled.println("Proyecto IoT - M14");
  
  oled.setCursor(0, 25);
  oled.println(mensaje);
  
  oled.setTextSize(2);
  oled.setCursor(0, 45);
  oled.print("Total: ");
  oled.println(cuenta);
  
  oled.display();
}
