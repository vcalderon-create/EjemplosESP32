// Importa la librería Keypad
#include <Keypad.h>

// Define número de filas y columnas
const uint8_t ROWS = 4;
const uint8_t COLS = 4;

// Distribución de teclas
char keys[ROWS][COLS] = {
  { '1', '2', '3', 'A' },
  { '4', '5', '6', 'B' },
  { '7', '8', '9', 'C' },
  { '*', '0', '#', 'D' }
};

// Pines correspondientes a las filas y columnas del circuito en Wokwi
uint8_t colPins[COLS] = { 16, 4, 2, 15 };
uint8_t rowPins[ROWS] = { 19, 18, 5, 17 };

// Crea objeto con los parámetros del Keypad
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

// Configuración del sistema de contraseña
const String SECRET_PASSWORD = "1234"; // Define aquí tu contraseña secreta
String inputPassword = "";             // Variable para acumular los intentos

void setup() {
  Serial.begin(9600);
  Serial.println("--- Sistema de Seguridad Activo ---");
  Serial.println("Introduce tu clave de 4 digitos y presiona [#] para validar.");
}

void loop() {
  // Obtiene la tecla presionada
  char key = keypad.getKey();
  
  // Comprueba que se haya presionado una tecla
  if (key) {
    
    // Si se presiona '#', validamos la contraseña acumulada
    if (key == '#') {
      Serial.println("\nVerificando contraseña...");
      
      if (inputPassword == SECRET_PASSWORD) {
        Serial.println("¡ACCESO CONCEDIDO! Bienvenido/a.");
      } else {
        Serial.println("¡ACCESO DENEGADO! Contraseña incorrecta.");
      }
      
      // Limpiamos la variable para el siguiente intento
      inputPassword = "";
      Serial.println("\nIntroduce tu clave de 4 digitos:");
      
    } 
    // Si se presiona '*', limpiamos lo escrito por si nos equivocamos
    else if (key == '*') {
      inputPassword = "";
      Serial.println("\nProgreso borrado. Introduce de nuevo:");
    } 
    // Si es cualquier otra tecla (números o letras), la acumulamos
    else {
      inputPassword += key;
      Serial.print("*"); // Muestra un asterisco por privacidad en el monitor serial
    }
  }
}
